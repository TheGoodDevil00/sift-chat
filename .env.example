# ==============================================================================
# Sift Environment Configuration
# ==============================================================================
# Note: You can either set keys here on the server OR enter them directly
# in the browser UI (Settings / Provider modal). Keys entered in the UI are
# stored strictly in your browser's localStorage and never saved on the server.

# --- OpenAI (Default) ---
# Supported latest models: gpt-6-astra (default), gpt-5.6-sol, gpt-5.6-terra, gpt-5.6-luna
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_REASONING_EFFORT=medium

# --- Anthropic ---
# Supported latest models: claude-sonnet-5-5 (default), claude-opus-5-5, claude-haiku-5-5, claude-fable-5-2
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Google Gemini ---
# Supported latest models: gemini-3.8-flash (default), gemini-3.5-flash-lite, gemini-3.1-pro-preview
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- DeepSeek ---
# Supported latest models: deepseek-flash (default, V4.1), deepseek-v4-pro, deepseek-chat, deepseek-reasoner
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# --- xAI (Grok) ---
# Supported latest models: grok-4.7 (default), grok-4.7-latest, grok-3
XAI_API_KEY=
XAI_MODEL=grok-4.7

# --- Cohere ---
# Supported latest models: command-a-plus-05-2026 (default), command-a-03-2025, command-r7b-12-2024
COHERE_API_KEY=
COHERE_MODEL=command-a-plus-05-2026

# --- Groq ---
# Supported latest models: llama-3.3-70b-versatile (default), mixtral-8x7b-32768
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenRouter ---
# Supported latest models: openai/gpt-5.6-sol (default), anthropic/claude-sonnet-5-5, google/gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-sol

# --- Persistence ---
DATABASE_PATH=./data/sift.sqlite
