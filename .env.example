# Note: You can either set keys here on the server OR enter them directly
# in the browser UI (Settings / Provider modal). Keys entered in the UI are
# stored strictly in your browser's localStorage and never saved on the server.

# --- Web Search Providers (Free tiers, no credit card required) ---
# Recommended: Configure both EXA_API_KEY and FIRECRAWL_API_KEY for optimal research quality.

# Exa AI (Primary): $10/mo free recurring (~2,500 neural searches/mo) -> https://exa.ai
EXA_API_KEY=

# Firecrawl (Secondary / Deep Scraper): 1,000 free credits/mo -> https://firecrawl.dev
FIRECRAWL_API_KEY=

# Tavily (Optional fallback): https://tavily.com
TAVILY_API_KEY=

# --- OpenAI (Default) ---
# Supported models: gpt-4o (default), gpt-4o-mini, o1, o3-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_REASONING_EFFORT=medium

# --- Anthropic ---
# Any model available to your key can be selected in the UI. A safe default:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- DeepSeek ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- xAI (Grok) ---
XAI_API_KEY=
XAI_MODEL=grok-3-latest

# --- Cohere ---
COHERE_API_KEY=
COHERE_MODEL=command-r-plus

# --- Groq ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-4.5-sonnet

# --- Persistence ---
DATABASE_PATH=./data/sift.sqlite
